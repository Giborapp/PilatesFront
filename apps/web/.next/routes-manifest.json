  "dynamicRoutes": [
    {
      "page": "/alunos/[studentId]",
      "regex": "^/alunos/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPstudentId": "nxtPstudentId"
      },
      "namedRegex": "^/alunos/(?<nxtPstudentId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/aulas/[classSessionId]",
