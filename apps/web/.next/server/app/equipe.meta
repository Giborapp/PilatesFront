{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/(app)/layout,_N_T_/(app)/equipe/layout,_N_T_/(app)/equipe/page,_N_T_/equipe"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/!KGFwcCk/equipe/__PAGE__",
    "/!KGFwcCk/equipe",
    "/!KGFwcCk",
    "/_index",
    "/_head"
  ]
}